# Documentation only: .env files are NOT loaded automatically.
# run.sh defaults to offline; opt in explicitly after authorising the provider.
XPERT_MODE=offline
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=baidu/ernie-5.5-flash-preview:free
LLM_API_KEY=YOUR_OWN_KEY

XPERT_WORKERS=4
XPERT_TIME_BUDGET_SECONDS=1500
# Free OpenRouter defaults: 40 attempts, at least 3.2 seconds apart.
XPERT_MAX_CALLS=40
XPERT_MIN_REQUEST_INTERVAL=3.2
LLM_JSON_MODE=1
LLM_MAX_OUTPUT_TOKENS=11000
# These estimate free-only token billing, not assessment paid-equivalent scoring.
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
# XPERT_CACHE_DIR=/private/path/cache
# XPERT_CORRECTIONS=/private/path/corrections.json
